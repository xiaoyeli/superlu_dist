prefix=@CMAKE_INSTALL_PREFIX@
libdir=@pkgconfig_libdir@
includedir=@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@

Name: @CMAKE_PROJECT_NAME@
Description: Distributed-memory direct solution of sparse systems of linear equations
Version: @PROJECT_VERSION@
URL: https://portal.nersc.gov/project/sparse/superlu/

Libs: -L${libdir} -lsuperlu_dist
Libs.private: @BLAS_LIB_EXPORT@ @LAPACK_LIB_EXPORT@ @PARMETIS_LIB_EXPORT@ @COLAMD_LIB_EXPORT@ @COMBBLAS_LIB_EXPORT@ @HIP_LIB_EXPORT@ @MATH_LIB_EXPORT@
Cflags: -I${includedir}
